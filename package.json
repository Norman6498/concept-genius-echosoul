{
  "name": "solenne",
  "version": "0.1.0",
  "private": true,
  "description": "Solenne — Adaptive AI emotional companion by Concept Genius",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "verify-infra": "npx tsx scripts/verify-infra.ts",
    "audit:production": "node scripts/audit-production.mjs",
    "catalog:books": "node scripts/catalog/books.mjs",
    "catalog:music": "node scripts/catalog/music.mjs",
    "catalog:cities": "node scripts/catalog/cities.mjs",
    "catalog:enrich": "node scripts/catalog/enrich.mjs",
    "catalog:validate": "node scripts/catalog/validate.mjs",
    "test:trial": "npx tsx scripts/test-music-meaning-trial.ts",
    "test:guest": "npx tsx scripts/test-guest-explorer.ts",
    "catalog:all": "node scripts/catalog/books.mjs && node scripts/catalog/music.mjs && node scripts/catalog/cities.mjs && node scripts/catalog/enrich.mjs && node scripts/catalog/validate.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.8",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "1.45.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.28.0",
    "eslint-config-next": "16.3.5",
    "playwright": "^1.63.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
