# ============================================================
# EchoSoul — Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real credentials.
# See docs/ENVIRONMENT.md for full documentation.
# ============================================================

# ── Supabase (Public — safe for browser) ──────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase (Server-only — NEVER expose to browser) ──────
# Used only in server-side API routes and migrations.
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenRouter (Server-only — NEVER expose to browser) ────
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── OpenRouter — Model selection (configurable) ───────────
# Change these to switch models without rewriting application logic.
# Use model IDs from https://openrouter.ai/models
OPENROUTER_CHAT_MODEL=google/gemma-3-27b-it:free
OPENROUTER_FAST_MODEL=google/gemma-3-12b-it:free
OPENROUTER_REASONING_MODEL=google/gemma-3-27b-it:free
OPENROUTER_EMBEDDING_MODEL=

# ── Application ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
